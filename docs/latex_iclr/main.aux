\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Training efficiency on NVIDIA H200 GPUs.} Results are mean $\pm $ sample standard deviation over three seeds from the same runs as Table~\ref {tab:main-results}. Step time and throughput exclude the first ten warm-up steps. GPU train minutes sum all measured optimization-step times, excluding teacher-cache construction, tokenization, and final evaluation. Peak GiB is the maximum allocated memory on the busiest GPU. Bold and underlined values denote the best and second-best results within each teacher--student configuration (ties at the displayed precision are included). Jobs used both isolated and GPU-sharing schedules, so these are observed sweep costs rather than controlled single-job hardware benchmarks.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:training-efficiency}{{2}{4}{\textbf {Training efficiency on NVIDIA H200 GPUs.} Results are mean $\pm $ sample standard deviation over three seeds from the same runs as Table~\ref {tab:main-results}. Step time and throughput exclude the first ten warm-up steps. GPU train minutes sum all measured optimization-step times, excluding teacher-cache construction, tokenization, and final evaluation. Peak GiB is the maximum allocated memory on the busiest GPU. Bold and underlined values denote the best and second-best results within each teacher--student configuration (ties at the displayed precision are included). Jobs used both isolated and GPU-sharing schedules, so these are observed sweep costs rather than controlled single-job hardware benchmarks}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Endpoint-interface ablation.} All variants optimize $\mathcal  {L}_{\mathrm  {end}}$ only, with $\mathcal  {L}_{H_0}=0$. Retained energy, Gram RMSE, and $k$NN overlap compare the original teacher embeddings with their fixed projected targets and are therefore not applicable to jointly learned interfaces. Orthogonal Procrustes leaves all three fixed-target geometry metrics unchanged.}}{4}{table.3}\protected@file@percent }
\newlabel{tab:interface-families}{{3}{4}{\textbf {Endpoint-interface ablation.} All variants optimize $\mathcal {L}_{\mathrm {end}}$ only, with $\mathcal {L}_{H_0}=0$. Retained energy, Gram RMSE, and $k$NN overlap compare the original teacher embeddings with their fixed projected targets and are therefore not applicable to jointly learned interfaces. Orthogonal Procrustes leaves all three fixed-target geometry metrics unchanged}{table.3}{}}
